# Image to run in compose.prod.yml.
# Build it locally with:
#   docker login dhi.io
#   docker build -t transponder:local .
# If you need onion relays, build instead with:
#   docker build --build-arg CARGO_FEATURES='--features tor' -t transponder:tor .
# Tor also needs writable state: set relays.tor_data_dir in the config to
# /var/lib/transponder/tor and add a writable volume at that container path in
# compose.prod.yml, owned by UID/GID 65532:65532 with mode 0700. The container's
# root filesystem is read-only. See README.md for Tor configuration details.
TRANSPONDER_IMAGE=transponder:local

# Runtime files and paths
TRANSPONDER_CONFIG_FILE=./config/production.toml
TRANSPONDER_CREDENTIALS_DIR=./credentials
TRANSPONDER_SERVER_PRIVATE_KEY_SECRET_FILE=./secrets/server_private_key

# Published port on localhost
TRANSPONDER_PUBLISHED_PORT=8080

# Logging
TRANSPONDER_LOGGING_LEVEL=info
# RUST_LOG overrides TRANSPONDER_LOGGING_LEVEL when set.
RUST_LOG=info,transponder=info,nostr_relay_pool=info,nostr_sdk=info,nostr=info,reqwest=warn,hyper=warn,hyper_util=warn,h2=warn,tower=warn,rustls=warn,tungstenite=warn,tokio_tungstenite=warn
